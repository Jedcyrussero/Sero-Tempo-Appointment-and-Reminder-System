# Core application
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-secret"
APPOINTMENT_REMINDER_INTERVAL_MINUTES="60"
APPOINTMENT_REMINDER_WINDOW_HOURS="24"
NEXT_PUBLIC_APP_NAME="TEMPO"
NODE_ENV="development"

# Public base URL used in OAuth redirects and password reset emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# SMTP email delivery for password reset links
# Gmail example: smtp.gmail.com, port 587, SMTP_SECURE=false, App Password
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="TEMPO <no-reply@example.com>"
